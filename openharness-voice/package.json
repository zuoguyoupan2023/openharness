{
  "name": "openharness-voice",
  "version": "0.1.0",
  "description": "DSH 语音插件（云 API STT/TTS）：浏览器 getUserMedia 采音 → host 半代理云 API 转写/朗读，规避 CORS、密钥不落浏览器。V1 仅接 Azure Speech。",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "openharness",
    "voice",
    "stt",
    "tts",
    "speech"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT"
}
