<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- OpenHarness —— 让 DSH web 的 getUserMedia 能采集麦克风进行语音输入（语音云插件 openharness-voice）。
	     这是「壳使能浏览器麦克风」的唯一必需权限描述；识别/合成走云端 API，本地不存音频。 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenHarness 需要使用麦克风进行语音输入（按住说话，松开转文字）。音频仅在本地采为归一化 PCM，随后交给语音云插件（宿主进程代理）做识别；不会上传到其它地方。</string>
</dict>
</plist>
